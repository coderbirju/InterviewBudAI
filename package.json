{
  "name": "interviewbudai",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, local-first, AI-assisted interview-prep coach (DSA + System Design).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && tsc -p packages/curriculum/tsconfig.scripts.json --noEmit && npm run typecheck:ui --workspace=@ibai/web",
    "typecheck:ui": "npm run typecheck:ui --workspace=@ibai/web",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "tsc --build && npm run build:ui --workspace=@ibai/web",
    "build:ui": "npm run build:ui --workspace=@ibai/web",
    "test": "vitest run && npm run test:ui --workspace=@ibai/web",
    "start": "node packages/web/bin/start.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run build && npm run test",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "esbuild": "0.21.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.3.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
