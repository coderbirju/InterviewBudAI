# InterviewBudAI configuration (bring-your-own-LLM, local-first).
#
# These are exactly the variables the app reads. Two ways to set them:
#   1. Copy this file to `.env` in the repo root and fill it in. `npm start`
#      loads it automatically (Node >= 20.12, built-in process.loadEnvFile;
#      variables already exported in your shell win over the file).
#   2. Or `export` them in your shell before `npm start`.
# NEVER commit your real .env (it is git-ignored). Leave unused lines blank.

# --- LLM provider (needed for the Quiz Master; everything else works without) ---
# Anthropic is used when BOTH a key and a model are set; otherwise Ollama is
# used when IBAI_OLLAMA_MODEL is set; otherwise the quiz is disabled.

# Anthropic (Claude): your API key. IBAI_ANTHROPIC_API_KEY takes precedence
# over ANTHROPIC_API_KEY if both are set.
ANTHROPIC_API_KEY=
IBAI_ANTHROPIC_API_KEY=
# Anthropic model name (required with a key), e.g. claude-sonnet-4-20250514.
IBAI_ANTHROPIC_MODEL=

# Ollama (local): model name, e.g. llama3. Run `ollama serve` first.
IBAI_OLLAMA_MODEL=
# Ollama endpoint. Default: http://127.0.0.1:11434
IBAI_OLLAMA_URL=

# --- Web server ---
# Where your personal progress lives. Default: ~/.interviewbudai/data (created
# automatically on first run). If you set this, the directory is NOT created
# for you — create it, or pick a location at http://127.0.0.1:4173/setup.
IBAI_DATA_DIR=
# Port for the localhost-only server (always binds 127.0.0.1). Default: 4173
IBAI_WEB_PORT=
