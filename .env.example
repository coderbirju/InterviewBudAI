# InterviewBudAI configuration (bring-your-own-LLM, local-first).
#
# These are exactly the variables the app reads. Two ways to set them:
#   1. Copy this file to `.env` in the repo root and fill it in. `npm start`
#      loads it automatically (built-in process.loadEnvFile, Node >= 20.12;
#      variables already exported in your shell win over the file).
#   2. Or `export` them in your shell before `npm start`.
# NEVER commit your real .env (it is git-ignored). Leave unused lines blank.

# --- LLM provider (needed for the Quiz Master; everything else works without) ---
# Precedence (first match wins):
#   1. Anthropic          — BOTH a key and IBAI_ANTHROPIC_MODEL are set
#   2. OpenAI-compatible  — BOTH IBAI_OPENAI_BASE_URL and IBAI_OPENAI_MODEL are set
#   3. Ollama             — IBAI_OLLAMA_MODEL is set
#   otherwise the quiz is disabled. Leave the lines of unused providers blank.

# Anthropic (Claude): your API key. IBAI_ANTHROPIC_API_KEY takes precedence
# over ANTHROPIC_API_KEY if both are set.
ANTHROPIC_API_KEY=
IBAI_ANTHROPIC_API_KEY=
# Anthropic model name (required with a key), e.g. claude-sonnet-4-20250514.
IBAI_ANTHROPIC_MODEL=

# OpenAI-compatible server (Docker Model Runner, llama.cpp, vLLM, LM Studio,
# Ollama's /v1, or a hosted OpenAI-style API). The base URL is the one that
# ends in /v1 (a bare origin gets /v1 appended; /engines or /engines/<engine>
# gets /v1; a bare Docker Model Runner host becomes .../engines/v1; a pasted
# /chat/completions is trimmed; no username/password in the URL). Examples:
#   Docker Model Runner (host, TCP enabled): http://localhost:12434/engines/v1
#   Docker Model Runner (inside a container): http://model-runner.docker.internal/engines/v1
#   LM Studio: http://localhost:1234/v1
IBAI_OPENAI_BASE_URL=
# Model id exactly as the server names it (e.g. an ai/... tag for DMR).
IBAI_OPENAI_MODEL=
# Optional bearer key (local servers need none). IBAI_OPENAI_API_KEY is sent to
# any base URL; OPENAI_API_KEY is used ONLY for https://api.openai.com (so a
# shell-wide OpenAI key never reaches a local or third-party server). With a
# key the base URL must be https (or http to localhost/127.0.0.1) — a key is
# never sent over plain HTTP to the network.
IBAI_OPENAI_API_KEY=
OPENAI_API_KEY=
# Optional request timeout in ms (default 120000; clamped to 5000-600000).
IBAI_OPENAI_TIMEOUT_MS=

# Ollama (local): model name, e.g. llama3. Run `ollama serve` first.
IBAI_OLLAMA_MODEL=
# Ollama endpoint. Default: http://127.0.0.1:11434
IBAI_OLLAMA_URL=

# --- Web server ---
# Where your personal progress lives (also the Docker notes folder unless
# IBAI_HOST_DATA_DIR is set). Default: ~/.interviewbudai/data (created
# automatically on first run). If you set this, the directory is NOT created
# for you — create it, or pick a location at http://127.0.0.1:4173/setup.
IBAI_DATA_DIR=
# Port for the localhost-only server (binds 127.0.0.1). Default: 4173
# Under Docker: the port published on 127.0.0.1 of your computer.
IBAI_WEB_PORT=

# --- Problem statements (ADR 0015) ---
# When you open a catalog problem, the local server can fetch that ONE
# problem's statement and starter code from leetcode.com (one request, no
# login, no cookies, rate-limited) and cache it in <data folder>/problem-cache/.
# Default: on, changeable in Settings. off/0/false turns it off and on/1/true
# turns it on; either value pins it (the Settings toggle becomes read-only).
# Blank: the Settings toggle decides.
IBAI_LEETCODE_FETCH=

# --- Docker (docker compose up; ADR 0011) ---
# Compose reads these to fill in compose.yaml; nothing in this file is passed
# into the container (so the keys above never reach it).
# Your notes folder on this computer, mounted at /data in the container.
# Default: IBAI_DATA_DIR above if set (the same folder as `npm start`), else
# ~/.interviewbudai/data. Set it to use a folder you chose at /setup.
# Windows: set this (or IBAI_DATA_DIR) to an absolute path.
IBAI_HOST_DATA_DIR=
# Linux Docker Engine: your `id -u` / `id -g` (default 1000).
IBAI_UID=
IBAI_GID=
