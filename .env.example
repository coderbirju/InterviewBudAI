# InterviewBudAI configuration (bring-your-own-LLM, local-first).
# Copy to .env and fill in. NEVER commit your real .env (see .gitignore).
# The project is not opinionated about models — configure whichever you use.

# Which provider adapter to use: openai | anthropic | ollama | ...
IBAI_LLM_PROVIDER=

# Model name for the chosen provider (e.g. gpt-4o, claude-3-5-sonnet, llama3).
IBAI_LLM_MODEL=

# API key for hosted providers (leave blank for local providers like Ollama).
IBAI_LLM_API_KEY=

# Optional custom endpoint/base URL (e.g. http://localhost:11434 for Ollama).
IBAI_LLM_BASE_URL=

# Storage adapter for the personal progress layer: git-local | ...
# Default is git-backed local files. Path is the user's private store.
IBAI_STORAGE_ADAPTER=git-local
IBAI_STORAGE_PATH=
