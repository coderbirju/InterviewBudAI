{
  "name": "@ibai/web",
  "version": "0.0.0",
  "private": true,
  "description": "Locally hosted web front-end. Thin; delegates to @ibai/core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "build:ui": "vite build --config web-ui/vite.config.ts",
    "typecheck:ui": "tsc --noEmit --project web-ui/tsconfig.json",
    "clean": "tsc --build --clean",
    "start": "node ./dist/server-bin.js"
  },
  "dependencies": {
    "@ibai/core": "0.0.0",
    "@ibai/curriculum": "0.0.0",
    "@ibai/providers": "0.0.0",
    "@ibai/storage": "0.0.0",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
