{
  "name": "@ibai/web",
  "version": "0.0.0",
  "private": true,
  "description": "Locally hosted web front-end. Thin; delegates to @ibai/core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "build:ui": "vite build --config web-ui/vite.config.ts",
    "typecheck:ui": "tsc --noEmit --project web-ui/tsconfig.json",
    "test:ui": "vitest run --config web-ui/vitest.config.ts",
    "clean": "tsc --build --clean",
    "start": "node ./bin/start.mjs",
    "serve": "node ./dist/server-bin.js"
  },
  "dependencies": {
    "@ibai/core": "0.0.0",
    "@ibai/curriculum": "0.0.0",
    "@ibai/providers": "0.0.0",
    "@ibai/storage": "0.0.0",
    "htmlparser2": "10.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "jsdom": "24.1.3",
    "lucide-react": "0.462.0",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
